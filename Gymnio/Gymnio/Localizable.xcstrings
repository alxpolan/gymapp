            "value": "Ne pozabi vnesti današnjega treninga."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ära unusta tänast treeningut logida."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neaizmirsti ierakstīt šodienas treniņu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepamiršk užregistruoti šiandienos treniruotės."
          }
        },
