    "notification.reminder.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergiss nicht dein heutiges Training zu loggen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't forget to log today's workout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No olvides registrar tu entrenamiento de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'oublie pas d'enregistrer ta séance du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dimenticare di registrare l’allenamento di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のワークアウトの記録を忘れずに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 운동 기록을 잊지 마세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeet niet je training van vandaag te loggen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se esqueça de registrar o treino de hoje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glem ikke at logge dagens træning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glöm inte att logga dagens träning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke glem å logge dagens trening."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä unohda kirjata päivän treeniä."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü antrenmanı kaydetmeyi unutma."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не забудьте записати сьогоднішнє тренування."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не забудьте записать сегодняшнюю тренировку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapomnij zapisać dzisiejszego treningu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezapomeňte zapsat dnešní trénink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezabudnite zapísať dnešný tréning."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne felejtsd el rögzíteni a mai edzést."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu uita să înregistrezi antrenamentul de azi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не забравяй да запишеш днешната тренировка."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην ξεχάσεις να καταγράψεις τη σημερινή προπόνηση."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne zaboravi unijeti današnji trening."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Не заборави да унесеш данашњи тренинг."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pozabi vnesti današnjega treninga."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ära unusta tänast treeningut logida."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neaizmirsti ierakstīt šodienas treniņu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepamiršk užregistruoti šiandienos treniruotės."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Mundu að skrá æfingu dagsins."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No oblidis registrar l'entrenament d'avui."
          }
        }
      }
    },
