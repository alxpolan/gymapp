    "paywall.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos verlängern sich automatisch, sofern nicht mind. 24 Std. vor Ablauf gekündigt. Verwaltung in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically unless cancelled at least 24h before the period ends. Manage in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente salvo cancelación al menos 24 h antes del fin del período. Gestionar en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements se renouvellent automatiquement sauf résiliation au moins 24 h avant la fin de la période. Gérer dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli abbonamenti si rinnovano automaticamente salvo disdetta almeno 24 ore prima della scadenza. Gestisci nelle Impostazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas renovam automaticamente, salvo cancelamento até 24 h antes do fim do período. Gerencie nos Ajustes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen worden automatisch verlengd, tenzij je uiterlijk 24 uur voor afloop opzegt. Beheer in Instellingen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは、期間終了の24時間前までに解約しない限り自動更新されます。設定から管理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 기간 종료 24시간 전까지 취소하지 않으면 자동 갱신됩니다. 설정에서 관리하세요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk, medmindre de opsiges mindst 24 timer før perioden slutter. Administrer i Indstillinger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationer förnyas automatiskt om de inte sägs upp minst 24 timmar före periodens slut. Hantera i Inställningar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk med mindre de sies opp minst 24 timer før perioden utløper. Administrer i Innstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukset uusiutuvat automaattisesti, ellei niitä peruuteta vähintään 24 tuntia ennen jakson päättymistä. Hallitse asetuksissa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikler, dönem bitmeden en az 24 saat önce iptal edilmezse otomatik olarak yenilenir. Ayarlar'dan yönet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписки поновлюються автоматично, якщо їх не скасувати щонайменше за 24 години до кінця періоду. Керуйте в Налаштуваннях."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки продлеваются автоматически, если не отменить их минимум за 24 часа до конца периода. Управление в Настройках."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcje odnawiają się automatycznie, o ile nie zostaną anulowane co najmniej 24 godziny przed końcem okresu. Zarządzaj w Ustawieniach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné se automaticky obnovuje, pokud ho nezrušíte nejméně 24 hodin před koncem období. Správa v Nastavení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predplatné sa automaticky obnovuje, ak ho nezrušíte najmenej 24 hodín pred koncom obdobia. Správa v Nastaveniach."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetések automatikusan megújulnak, ha nem mondod le legalább 24 órával az időszak vége előtt. Kezelés a Beállításokban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonamentele se reînnoiesc automat dacă nu sunt anulate cu cel puțin 24 de ore înainte de sfârșitul perioadei. Gestionează în Setări."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Абонаментите се подновяват автоматично, освен ако не бъдат отказани поне 24 часа преди края на периода. Управлявай от Настройки."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συνδρομές ανανεώνονται αυτόματα εκτός αν ακυρωθούν τουλάχιστον 24 ώρες πριν από τη λήξη της περιόδου. Διαχείριση στις Ρυθμίσεις."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplate se automatski obnavljaju osim ako se ne otkažu najmanje 24 sata prije kraja razdoblja. Upravljaj u Postavkama."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Претплате се аутоматски обнављају осим ако се не откажу најмање 24 сата пре краја периода. Управљај у Подешавањима."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naročnine se samodejno obnovijo, razen če jih prekličeš vsaj 24 ur pred koncem obdobja. Upravljaj v Nastavitvah."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tellimused uuenevad automaatselt, kui neid ei tühistata vähemalt 24 tundi enne perioodi lõppu. Halda seadetes."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonementi tiek atjaunoti automātiski, ja tie netiek atcelti vismaz 24 stundas pirms perioda beigām. Pārvaldi iestatījumos."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumeratos atnaujinamos automatiškai, nebent atšaukiamos likus bent 24 val. iki laikotarpio pabaigos. Tvarkyk nustatymuose."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Áskriftir endurnýjast sjálfkrafa nema þeim sé sagt upp að minnsta kosti 24 klukkustundum fyrir lok tímabilsins. Stjórnaðu í Stillingum."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les subscripcions es renoven automàticament tret que es cancel·lin almenys 24 hores abans del final del període. Gestiona-ho a Configuració."
          }
        }
      }
    },
