          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживай вес тела рядом со своими подъёмами."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź masę ciała obok swoich ciężarów."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj svou tělesnou hmotnost vedle svých zdvihů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj svoju telesnú hmotnosť vedľa svojich zdvihov."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesd a testsúlyodat a emelések mellett."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește-ți greutatea corporală alături de ridicări."
