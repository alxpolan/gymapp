    "icloud.found.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore your workouts, routines and records on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle deine Trainings, Routinen und Rekorde auf diesem Gerät wieder her."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वर्कआउट, रूटीन और रिकॉर्ड इस डिवाइस पर वापस लाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan latihan, rutinitas, dan rekormu di perangkat ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục buổi tập, giáo án và kỷ lục của bạn trên thiết bị này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนเวิร์กเอาต์ รูทีน และสถิติของคุณบนอุปกรณ์เครื่องนี้"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعد تمارينك وروتيناتك وأرقامك القياسية على هذا الجهاز."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上恢复你的训练、计划和纪录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此裝置上還原你的訓練、計畫與紀錄。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שחזר את האימונים, השגרות והשיאים שלך במכשיר הזה."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan latihan, rutin dan rekod anda pada peranti ini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibalik ang mga workout, routine at rekord mo sa device na ito."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে আপনার ওয়ার্কআউট, রুটিন ও রেকর্ড ফিরিয়ে আনুন।"
          }
        }
      }
    },
