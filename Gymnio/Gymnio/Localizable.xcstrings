          "stringUnit": {
            "state": "translated",
            "value": "Nezapomeňte zapsat dnešní trénink."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezabudnite zapísať dnešný tréning."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne felejtsd el rögzíteni a mai edzést."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu uita să înregistrezi antrenamentul de azi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не забравяй да запишеш днешната тренировка."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην ξεχάσεις να καταγράψεις τη σημερινή προπόνηση."
