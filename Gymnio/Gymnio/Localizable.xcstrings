    "notification.celebration.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %lld Einträge erreicht. Weiter so!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached %lld entries. Keep it up!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado %lld registros. ¡Sigue así!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as atteint %lld entrées. Continue comme ça !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto %lld voci. Continua così!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você alcançou %lld registros. Continue assim!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt %lld items bereikt. Ga zo door!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の記録を達成しました！この調子！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개의 기록을 달성했습니다! 계속하세요!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nået %lld registreringer. Hold det op!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nått %lld poster. Fortsätt så!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nådd %lld registreringer. Fortsett sånn!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet saavuttanut %lld merkintää. Jatka samaan malliin!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kayda ulaştın. Böyle devam!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви досягли %lld записів. Так тримати!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы достигли %lld записей. Так держать!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto %lld wpisów. Tak trzymaj!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosáhli jste %lld záznamů. Tak dál!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosiahli ste %lld záznamov. Len tak ďalej!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elérted a(z) %lld bejegyzést. Így tovább!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai ajuns la %lld înregistrări. Continuă tot așa!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигна %lld записа. Продължавай така!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έφτασες τις %lld καταχωρίσεις. Συνέχισε έτσι!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosegnuo si %lld zapisa. Samo tako dalje!"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигао си %lld уноса. Само тако даље!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosegel si %lld vnosov. Le tako naprej!"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Oled jõudnud %lld kirjeni. Jätka samas vaimus!"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu esi sasniedzis %lld ierakstus. Turpini tā!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasiekei %lld įrašų. Taip ir toliau!"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú hefur náð %lld færslum. Haltu áfram!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has arribat als %lld registres. Continua així!"
          }
        }
      }
    },
