    "insights.teaser.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below is a preview with sample data. Log a workout and these cards fill with your own progress."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten siehst du eine Vorschau mit Beispieldaten. Sobald du trainierst, füllen sich die Karten mit deinem Fortschritt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici un aperçu avec des données d'exemple. Enregistre une séance et ces cartes se rempliront avec ta progression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abajo tienes una vista previa con datos de ejemplo. Registra un entrenamiento y estas tarjetas se llenarán con tu progreso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui sotto trovi un'anteprima con dati di esempio. Registra un allenamento e queste schede si riempiranno con i tuoi progressi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em baixo vês uma pré-visualização com dados de exemplo. Regista um treino e estes cartões enchem-se com o teu progresso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hieronder zie je een voorbeeld met demogegevens. Log een training en deze kaarten vullen zich met je eigen voortgang."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Herunder ser du en forhåndsvisning med eksempeldata. Log en træning, så fyldes kortene med din egen fremgang."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedan ser du en förhandsvisning med exempeldata. Logga ett pass så fylls korten med dina egna framsteg."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Under ser du en forhåndsvisning med eksempeldata. Logg en økt, så fylles kortene med din egen fremgang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla on esikatselu esimerkkitiedoilla. Kirjaa treeni, niin kortit täyttyvät omalla edistymiselläsi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hér að neðan sérðu forsýningu með sýnigögnum. Skráðu æfingu og spjöldin fyllast af þínum eigin framförum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıda örnek verilerle bir önizleme var. Bir antrenman kaydet, bu kartlar kendi ilerlemenle dolsun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижче — попередній перегляд із прикладами даних. Запиши тренування, і ці картки заповняться твоїм прогресом."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниже — предпросмотр с примерами данных. Запиши тренировку, и эти карточки заполнятся твоим прогрессом."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniżej podgląd z przykładowymi danymi. Zapisz trening, a karty wypełnią się Twoimi postępami."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Níže je náhled s ukázkovými daty. Zapiš trénink a tyto karty se zaplní tvým pokrokem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nižšie je náhľad s ukážkovými údajmi. Zapíš tréning a tieto karty sa zaplnia tvojím pokrokom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alább egy előnézet mintaadatokkal. Rögzíts egy edzést, és a kártyák megtelnek a saját fejlődéseddel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai jos este o previzualizare cu date de exemplu. Notează un antrenament și aceste carduri se vor umple cu progresul tău."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По-долу е визуализация с примерни данни. Запиши тренировка и картите ще се попълнят с твоя напредък."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακάτω βλέπεις μια προεπισκόπηση με δείγμα δεδομένων. Κατέγραψε μια προπόνηση και αυτές οι κάρτες θα γεμίσουν με τη δική σου πρόοδο."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispod je pregled s primjerima podataka. Zabilježi trening i ove kartice popunit će se tvojim napretkom."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispod je pregled sa primerima podataka. Zabeleži trening i ove kartice će se popuniti tvojim napretkom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spodaj je predogled z vzorčnimi podatki. Zabeleži trening in te kartice se bodo napolnile z tvojim napredkom."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allpool on eelvaade näidisandmetega. Logi trenn ja need kaardid täituvad sinu enda edusammudega."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Zemāk ir priekšskatījums ar paraugdatiem. Reģistrē treniņu, un šīs kartes piepildīsies ar tavu progresu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žemiau – peržiūra su pavyzdiniais duomenimis. Užfiksuok treniruotę, ir šios kortelės užsipildys tavo pažanga."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A sota tens una vista prèvia amb dades d'exemple. Registra un entrenament i aquestes targetes s'ompliran amb el teu progrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下はサンプルデータのプレビューです。ワークアウトを記録すると、これらのカードがあなたの進捗で埋まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래는 샘플 데이터 미리보기예요. 운동을 기록하면 이 카드들이 내 진행 상황으로 채워져요."
          }
        }
      }
    },
