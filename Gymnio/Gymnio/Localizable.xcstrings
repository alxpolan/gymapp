        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log et par træninger for at låse op for dine indsigter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga några träningspass för att låsa upp dina insikter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg noen treningsøkter for å låse opp innsikten din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa muutama treeni avataksesi oivalluksesi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçgörülerinin kilidini açmak için birkaç antrenman kaydet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть кілька тренувань, щоб відкрити аналітику."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите несколько тренировок, чтобы открыть аналитику."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz kilka treningów, aby odblokować statystyki."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište pár tréninků a odemkněte své statistiky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíšte pár tréningov a odomknite svoje štatistiky."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíts néhány edzést a statisztikák feloldásához."
          }
        },
        "ro": {
