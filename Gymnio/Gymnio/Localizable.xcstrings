    "paywall.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos verlängern sich automatisch, sofern nicht mind. 24 Std. vor Ablauf gekündigt. Verwaltung in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically unless cancelled at least 24h before the period ends. Manage in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente salvo cancelación al menos 24 h antes del fin del período. Gestionar en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements se renouvellent automatiquement sauf résiliation au moins 24 h avant la fin de la période. Gérer dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli abbonamenti si rinnovano automaticamente salvo disdetta almeno 24 ore prima della scadenza. Gestisci nelle Impostazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas renovam automaticamente, salvo cancelamento até 24 h antes do fim do período. Gerencie nos Ajustes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen worden automatisch verlengd, tenzij je uiterlijk 24 uur voor afloop opzegt. Beheer in Instellingen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは、期間終了の24時間前までに解約しない限り自動更新されます。設定から管理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 기간 종료 24시간 전까지 취소하지 않으면 자동 갱신됩니다. 설정에서 관리하세요."
          }
        }
      }
    },
