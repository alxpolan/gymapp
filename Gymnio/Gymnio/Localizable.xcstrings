    "customize.tip": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Aktiviere den Steigerungsvorschlag, um personalisierte Gewichtsempfehlungen zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Enable the progression alert for personalized weight suggestions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: activa la alerta de progresión para sugerencias de peso personalizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : active l’alerte de progression pour des suggestions de charge personnalisées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: attiva l’avviso di progressione per suggerimenti di carico personalizzati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: ative o alerta de progressão para sugestões de carga personalizadas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: schakel de progressiemelding in voor persoonlijke gewichtssuggesties."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：パーソナライズされた重量提案のため、プログレッションアラートをオンに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 맞춤형 중량 제안을 위해 프로그레션 알림을 켜세요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Aktivér progressionsadvarslen for personlige vægtforslag."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: Aktivera progressionsvarningen för personliga viktförslag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: Slå på progresjonsvarselet for personlige vektforslag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinkki: Ota etenemisvaroitus käyttöön saadaksesi henkilökohtaisia painoehdotuksia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Kişiye özel ağırlık önerileri için ilerleme uyarısını aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порада: увімкніть сповіщення про прогресію, щоб отримувати персональні пропозиції щодо ваги."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: включите уведомление о прогрессии, чтобы получать персональные подсказки по весу."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: włącz alert progresji, aby otrzymywać spersonalizowane propozycje ciężaru."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Zapněte upozornění na progresi pro osobní návrhy zátěže."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Zapnite upozornenie na progresiu pre osobné návrhy záťaže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Kapcsold be a progressziójelzést személyre szabott súlyjavaslatokért."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfat: activează alerta de progresie pentru sugestii personalizate de greutate."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съвет: включи известието за прогресия за персонализирани предложения за тежест."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμβουλή: Ενεργοποίησε την ειδοποίηση προόδου για εξατομικευμένες προτάσεις βάρους."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savjet: uključi upozorenje o progresiji za osobne prijedloge težine."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Савет: укључи упозорење о прогресији за персонализоване предлоге тежине."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namig: vklopi opozorilo o napredovanju za osebne predloge teže."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Näpunäide: lülita sisse progressiooni hoiatus isikupärastatud raskusettepanekute jaoks."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Padoms: ieslēdz progresijas brīdinājumu personalizētiem svara ieteikumiem."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patarimas: įjunk progreso įspėjimą, kad gautum asmeninių svorio pasiūlymų."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábending: Kveiktu á framvinduviðvöruninni fyrir persónulegar þyngdartillögur."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Consell: activa l'alerta de progressió per rebre suggeriments de pes personalitzats."
          }
        }
      }
