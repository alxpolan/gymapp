          "stringUnit": {
            "state": "translated",
            "value": "Log een paar workouts om je inzichten te ontgrendelen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウトを記録してインサイトを解放しましょう。"
