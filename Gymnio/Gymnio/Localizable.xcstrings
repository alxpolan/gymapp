    "paywall.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainiere smarter – mit erweiterten Metriken und einem Coach in der Tasche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Train smarter with advanced metrics and a coach in your pocket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrena más inteligente, con métricas avanzadas y un coach en el bolsillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne-toi plus intelligemment, avec des métriques avancées et un coach dans la poche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati in modo più intelligente, con metriche avanzate e un coach in tasca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treine de forma mais inteligente, com métricas avançadas e um coach no bolso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Train slimmer – met geavanceerde statistieken en een coach in je zak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度な指標とポケットコーチで、賢くトレーニング。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고급 지표와 포켓 코치로 더 스마트하게 운동하세요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træn smartere med avancerede målinger og en coach i lommen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Träna smartare med avancerade mätvärden och en coach i fickan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tren smartere med avanserte målinger og en coach i lommen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Treenaa fiksummin edistyneillä mittareilla ja valmentajalla taskussa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelişmiş metrikler ve cebindeki bir koçla daha akıllı antrenman yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренуйтеся розумніше з розширеними показниками та тренером у кишені."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируйтесь умнее с расширенными показателями и тренером в кармане."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenuj mądrzej dzięki zaawansowanym wskaźnikom i trenerowi w kieszeni."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trénujte chytřeji s pokročilými metrikami a trenérem v kapse."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trénujte múdrejšie s pokročilými metrikami a trénerom vo vrecku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Edzz okosabban fejlett mutatókkal és egy edzővel a zsebedben."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenează-te mai inteligent cu metrici avansate și un antrenor în buzunar."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренирай по-умно с разширени показатели и треньор в джоба."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προπονήσου πιο έξυπνα με προηγμένες μετρήσεις και έναν προπονητή στην τσέπη σου."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treniraj pametnije uz napredne metrike i trenera u džepu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренирај паметније уз напредне метрике и тренера у џепу."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treniraj pametneje z naprednimi metrikami in trenerjem v žepu."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Treeni targemalt täiustatud mõõdikute ja treeneriga taskus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenējies gudrāk ar paplašinātiem rādītājiem un treneri kabatā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treniruokis protingiau su išplėstiniais rodikliais ir treneriu kišenėje."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Æfðu snjallar með ítarlegum mælikvörðum og þjálfara í vasanum."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrena més intel·ligentment amb mètriques avançades i un entrenador a la butxaca."
          }
        }
      }
    },
