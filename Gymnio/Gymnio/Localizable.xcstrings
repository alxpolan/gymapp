    "routines.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your usual workout once and start it with one tap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere dein Standardtraining einmal und starte es mit einem Tipp."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ta séance habituelle une fois et lance-la d'un seul toucher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu entrenamiento habitual una vez y empiézalo con un toque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una volta il tuo allenamento abituale e avvialo con un tocco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda o teu treino habitual uma vez e inicia-o com um toque."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar je vaste training één keer en start hem met één tik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem din faste træning én gang og start den med ét tryk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara ditt vanliga pass en gång och starta det med ett tryck."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre den vanlige økten din én gang og start den med ett trykk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna tavallinen treenisi kerran ja aloita se yhdellä napautuksella."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vistaðu venjulegu æfinguna þína einu sinni og byrjaðu hana með einum smelli."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki antrenmanını bir kez kaydet, tek dokunuşla başlat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережи своє звичне тренування один раз і запускай одним дотиком."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохрани привычную тренировку один раз и запускай одним касанием."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz swój zwykły trening raz i uruchamiaj go jednym dotknięciem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulož svůj obvyklý trénink jednou a spouštěj ho jedním klepnutím."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulož svoj obvyklý tréning raz a spúšťaj ho jedným ťuknutím."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd el a szokásos edzésedet egyszer, és indítsd egy érintéssel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează antrenamentul obișnuit o dată și pornește-l dintr-o atingere."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запази обичайната си тренировка веднъж и я започвай с едно докосване."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθήκευσε την τακτική σου προπόνηση μία φορά και ξεκίνα την με ένα άγγιγμα."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremi svoj uobičajeni trening jednom i pokreni ga jednim dodirom."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sačuvaj svoj uobičajeni trening jednom i pokreni ga jednim dodirom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrani svoj običajni trening enkrat in ga zaženi z enim dotikom."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta oma tavaline trenn üks kord ja alusta seda ühe puudutusega."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saglabā savu ierasto treniņu vienreiz un sāc to ar vienu pieskārienu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išsaugok įprastą treniruotę vieną kartą ir pradėk ją vienu palietimu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa el teu entrenament habitual una vegada i comença'l amb un toc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつものワークアウトを一度保存すれば、ワンタップで開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 운동을 한 번 저장하고 한 번의 탭으로 시작하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना रोज़ का वर्कआउट एक बार सेव करें और एक टैप में शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan latihan rutinmu sekali lalu mulai dengan satu ketukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu buổi tập quen thuộc một lần và bắt đầu chỉ với một chạm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกเวิร์กเอาต์ประจำของคุณครั้งเดียว แล้วเริ่มได้ด้วยการแตะเดียว"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تمرينك المعتاد مرة واحدة وابدأه بلمسة واحدة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存一次你常做的训练，之后一键开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存一次你常做的訓練，之後一鍵開始。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור את האימון הקבוע שלך פעם אחת והתחל אותו בהקשה אחת."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan latihan biasa anda sekali dan mulakannya dengan satu ketikan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-save nang isang beses ang karaniwan mong workout at simulan ito sa isang tap."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিয়মিত ওয়ার্কআউট একবার সেভ করুন, এক ট্যাপে শুরু করুন।"
          }
        }
      }
    },
