{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    " ": {
      "comment": "A placeholder string.",
      "isCommentAutoGenerated": true
    },
    "%@ (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ %@": {
      "comment": "A tooltip that displays the weight value and unit of a selected point on a chart.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ • %@": {
      "comment": "A label displaying the weight and date of a selected point on a chart.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ • %3$@"
          }
        }
      }
    },
    "%@ %@ × %lld %@": {
      "comment": "A label displaying the exercise name, weight, and number of repetitions. The first argument is the name of the exercise. The second argument is the formatted weight value. The third argument is the unit of measurement. The fourth argument is the number of repetitions.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ × %3$lld %4$@"
          }
        }
      }
    },
    "%lld": {},
    "%lld%%": {
      "comment": "A percentage.",
      "isCommentAutoGenerated": true
    },
    "× %lld %@": {
      "comment": "A label that combines a weight value with a repetition count, separated by an asterisk and a space. The argument is the string “common.reps”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "× %1$lld %2$@"
          }
        }
      }
    },
    "0": {
      "comment": "A placeholder text for a text field.",
      "isCommentAutoGenerated": true
    },
