          "stringUnit": {
            "state": "translated",
            "value": "Упражнения готовы! Нажмите на упражнение и сделайте первую запись."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenia gotowe! Stuknij ćwiczenie i dodaj pierwszy wpis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cvičení jsou připravena! Klepněte na cvičení a zapište první záznam."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cvičenia sú pripravené! Klepnite na cvičenie a zapíšte prvý záznam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyakorlatok készen állnak! Koppints egy gyakorlatra, és rögzítsd az első bejegyzésed."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercițiile sunt gata! Atinge un exercițiu și adaugă prima înregistrare."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражненията са готови! Докосни упражнение и направи първия си запис."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ασκήσεις είναι έτοιμες! Πάτα μια άσκηση και κατάγραψε την πρώτη σου καταχώριση."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vježbe su spremne! Dodirni vježbu i unesi prvi zapis."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Вежбе су спремне! Додирни вежбу и унеси први унос."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaje so pripravljene! Tapni vajo in vnesi prvi vnos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjutused on valmis! Puuduta harjutust ja tee esimene kirje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vingrinājumi ir gatavi! Pieskaries vingrinājumam un izdari pirmo ierakstu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratimai paruošti! Bakstelėk pratimą ir padaryk pirmą įrašą."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Æfingarnar eru tilbúnar! Ýttu á æfingu og skráðu fyrstu færsluna."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els exercicis estan a punt! Toca un exercici i fes el teu primer registre."
          }
        }
      }
    },
