          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü antrenmanı kaydetmeyi unutma."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не забудьте записати сьогоднішнє тренування."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не забудьте записать сегодняшнюю тренировку."
          }
        },
