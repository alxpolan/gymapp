          "stringUnit": {
            "state": "translated",
            "value": "Não se esqueça de registrar o treino de hoje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeet niet je training van vandaag te loggen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のワークアウトの記録を忘れずに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 운동 기록을 잊지 마세요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glem ikke at logge dagens træning."
          }
        },
