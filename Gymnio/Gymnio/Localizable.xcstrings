    "notification.reminder.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergiss nicht dein heutiges Training zu loggen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't forget to log today's workout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No olvides registrar tu entrenamiento de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'oublie pas d'enregistrer ta séance du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dimenticare di registrare l’allenamento di oggi."
          }
        },
