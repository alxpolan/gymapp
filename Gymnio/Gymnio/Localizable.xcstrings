    "pro.active.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du Gymnio unterstützt. Alle erweiterten Metriken und KI-Coach-Funktionen sind freigeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for supporting Gymnio. Every advanced metric and AI Coach feature is unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por apoyar a Gymnio. Todas las métricas avanzadas y funciones de Coach IA están desbloqueadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de soutenir Gymnio. Toutes les métriques avancées et fonctions du Coach IA sont débloquées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per supportare Gymnio. Tutte le metriche avanzate e le funzioni del Coach IA sono sbloccate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por apoiar o Gymnio. Todas as métricas avançadas e funções do Coach IA estão desbloqueadas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt voor je steun aan Gymnio. Alle geavanceerde statistieken en AI-coachfuncties zijn ontgrendeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gymnioを応援いただきありがとうございます。すべての高度な指標とAIコーチ機能が解放されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gymnio를 응원해 주셔서 감사합니다. 모든 고급 지표와 AI 코치 기능이 해제되었습니다."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak, fordi du støtter Gymnio. Alle avancerede målinger og AI-coach-funktioner er låst op."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du stöttar Gymnio. Alla avancerade mätvärden och AI-coach-funktioner är upplåsta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du støtter Gymnio. Alle avanserte målinger og AI-coach-funksjoner er låst opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos, että tuet Gymnioa. Kaikki edistyneet mittarit ja AI-valmentajan ominaisuudet on avattu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gymnio'yu desteklediğin için teşekkürler. Tüm gelişmiş metriklerin ve AI Koç özelliklerinin kilidi açıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо, що підтримуєте Gymnio. Усі розширені показники та функції AI-тренера відкрито."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо, что поддерживаете Gymnio. Все расширенные показатели и функции AI-тренера открыты."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy za wsparcie Gymnio. Wszystkie zaawansowane wskaźniki i funkcje trenera AI są odblokowane."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Děkujeme, že podporujete Gymnio. Všechny pokročilé metriky a funkce AI trenéra jsou odemčeny."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďakujeme, že podporujete Gymnio. Všetky pokročilé metriky a funkcie AI trénera sú odomknuté."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Köszönjük, hogy támogatod a Gymniót. Minden fejlett mutató és AI edző funkció fel van oldva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulțumim că susții Gymnio. Toate metricile avansate și funcțiile antrenorului AI sunt deblocate."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Благодарим, че подкрепяш Gymnio. Всички разширени показатели и функции на AI треньора са отключени."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε που υποστηρίζεις το Gymnio. Όλες οι προηγμένες μετρήσεις και οι λειτουργίες του AI Προπονητή είναι ξεκλείδωτες."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvala što podržavaš Gymnio. Sve napredne metrike i značajke AI trenera su otključane."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвала што подржаваш Gymnio. Све напредне метрике и функције AI тренера су откључане."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvala, da podpiraš Gymnio. Vse napredne metrike in funkcije AI trenerja so odklenjene."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Aitäh, et toetad Gymniot. Kõik täiustatud mõõdikud ja AI treeneri funktsioonid on avatud."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paldies, ka atbalsti Gymnio. Visi paplašinātie rādītāji un AI trenera funkcijas ir atbloķētas."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ačiū, kad palaikai Gymnio. Visi išplėstiniai rodikliai ir AI trenerio funkcijos atrakinti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk fyrir að styðja Gymnio. Allir ítarlegir mælikvarðar og eiginleikar AI-þjálfarans eru opnir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gràcies per donar suport a Gymnio. Totes les mètriques avançades i les funcions de l'entrenador d'IA estan desbloquejades."
          }
        }
      }
    },
